# Copy this file to .env and fill in your keys.
# Generation tries configured providers in FreeLLMAPI, Gemini, Groq, OpenRouter order.
# Invalid keys or exhausted quota can still fail. Costs depend on your account.
# On Windows, keys saved through Settings use the encrypted credential store.
# Keys entered here stay plaintext until re-entered and saved in Settings.
# Encrypted settings (including removals) take precedence over this file.

# Groq key management: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio key management: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter key management: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# FreeLLMAPI (https://github.com/tashfeenahmed/freellmapi) runs on this computer or your
# home network and spreads requests over many free AI services. Use its unified key, or
# an address with its own access token (.../v1/t/flmurl_...) instead of a key.
# The address must be on this computer or your home network; without one Marteloio uses
# the desktop app's http://127.0.0.1:31415/v1 (Docker and Node use port 3001).
FREELLMAPI_KEY=
# FREELLMAPI_URL=http://127.0.0.1:31415/v1

# eBay Developers - free account: https://developer.ebay.com/
# Needed only for keyword mining and trust-header auto-fill.
# The tool works without these (LLM-only keywords, manual stats).
# Do NOT put eBay credentials here: enter them in the Settings UI instead.
# With Windows DPAPI these use .marteloio-secrets.enc. Without DPAPI,
# eBay credentials fall back to plaintext .env and tokens to .ebay_token.json.
# Provider keys above remain plaintext in .env.

# Optional local app port:
# PORT=8080
